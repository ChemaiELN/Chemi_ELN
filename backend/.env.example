# ============================================================
#  Laurus ELN — Backend configuration
#  Copy this file to ".env" and edit the values below.
# ============================================================

# PostgreSQL connection. Replace user, password, host and db name to match
# the server's database. The DB must already exist (it can be empty).
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/laurus_eln

# Secret used to sign login tokens. Generate a fresh one on the server with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-python-secrets-token-hex-32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browsers loading the frontend must be listed here or the API will block them.
# Use the SERVER's intranet IP and the frontend port (default 9091).
# Set to the server's intranet IP and the frontend port (default 9091).
CORS_ORIGINS=["http://10.10.51.90:9091"]

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800
MAX_BODY_BYTES=10485760
