# ==============================================================
#  Laurus ELN — Backend environment (Ubuntu / production)
#  Copy to /opt/laurus-eln/backend/.env and edit.
#  The app reads this file via dotenv from its WorkingDirectory,
#  so it MUST live next to dist/ as /opt/laurus-eln/backend/.env
# ==============================================================

# ── Server ────────────────────────────────────────────────────
# Bound to all interfaces, but nginx proxies to it on 127.0.0.1,
# so port 8000 does NOT need to be open in the firewall.
PORT=8000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laurus_eln
DB_USER=laurus
# Set this to the password created by install.sh (or your own).
DB_PASSWORD=CHANGE_ME

# Alternative to the DB_* vars above. If set, it wins.
# NOTE: special characters in the password must be URL-encoded
#       (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# DATABASE_URL=postgresql://laurus:CHANGE_ME@localhost:5432/laurus_eln

# ── JWT ───────────────────────────────────────────────────────
# REQUIRED — the backend refuses to start without it.
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────
# Frontend and API are served from the SAME origin through nginx
# (http://192.168.205.247/api/...), so CORS is not exercised in
# normal use. Kept accurate for direct API calls and tooling.
CORS_ORIGINS=http://192.168.205.247

# ── File uploads ──────────────────────────────────────────────
# Absolute path so it never depends on the process working dir.
# install.sh pre-creates every required subdirectory — multer does
# NOT create them on demand and uploads fail with ENOENT if missing.
UPLOAD_DIR=/opt/laurus-eln/backend/uploads
# 50 MB. Keep nginx's client_max_body_size comfortably above this.
MAX_UPLOAD_BYTES=52428800
MAX_BODY_BYTES=10485760

# ── AD (Analytical R&D) integration — optional ────────────────
# Only needed if this server pushes "Submit to AD" requests to a
# separate ARD backend. The app runs fine with these empty.
AD_API_BASE_URL=
AD_INTEGRATION_API_KEY=
AD_DEFAULT_TL_USERNAME=
