<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for hosting the Laurus ELN frontend (place this in the folder
  you point the IIS site at - i.e. alongside index.html, inside dist\).

  - Serves the built React static files.
  - SPA fallback: any URL that is NOT a real file/folder is served
    index.html (via the 404 -> index.html rewrite in httpErrors), so
    /login and browser refreshes work. This needs NO extra IIS modules.
  - The frontend still calls the backend API directly at the URL set in
    config.js (http://10.10.51.90:8000). IIS is only serving static files.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- make sure JS/JSON/wasm are served with correct types -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>

    <!-- SPA fallback without URL Rewrite module:
         when a path is not found (404), return index.html with 200 -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
